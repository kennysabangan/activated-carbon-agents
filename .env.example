# Copy to .env.local and fill in. .env.local is git-ignored.
# Values are quoted so the file can also be sourced by a shell.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=""

# Primary recipient of lead notifications.
CONTACT_TO_EMAIL="kim@activatedcarbonagents.com"

# Blind-copied on every lead. Leave empty to send no BCC.
CONTACT_BCC_EMAIL="hello@scalesolving.com"

# Sender address. Must be on a domain verified at https://resend.com/domains —
# the shared onboarding@resend.dev sender only delivers to the Resend account
# owner and rejects all other recipients.
CONTACT_FROM_EMAIL="Activated Carbon Agents <leads@activatedcarbonagents.com>"
