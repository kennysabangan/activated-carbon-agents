# Copy to .env.local and fill in. .env.local is git-ignored.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where internal lead notifications are delivered.
CONTACT_TO_EMAIL=hello@scalesolving.com

# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Activated Carbon Agents <onboarding@resend.dev>
